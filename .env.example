# =============================================================================
# Flask Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control.
# This template contains placeholder values only — no real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask Configuration
# -----------------------------------------------------------------------------
# FLASK_ENV: Sets the Flask environment. Use 'development', 'testing', or
#            'production'. Controls debug mode, logging verbosity, and which
#            configuration class is loaded by the Application Factory.
FLASK_ENV=development

# SECRET_KEY: Cryptographic key used by Flask for session signing, CSRF tokens,
#             and cookie security. MUST be changed to a strong random value in
#             production. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key

# DEBUG: Enables Flask debug mode with auto-reload and interactive debugger.
#        Set to 'false' in production. Overridden by FLASK_ENV in config classes.
DEBUG=true

# -----------------------------------------------------------------------------
# Auth0 Configuration
# -----------------------------------------------------------------------------
# Auth0 provides externalized authentication and authorization via OAuth 2.0
# and OpenID Connect. The JWT verification middleware validates every protected
# request using these settings (6-step pipeline: presence → signature → issuer
# → audience → expiration → RBAC).
#
# AUTH0_DOMAIN: Your Auth0 tenant domain (e.g., 'your-tenant.auth0.com').
#              Used to construct the JWKS endpoint URL for RS256 key retrieval.
AUTH0_DOMAIN=your-tenant.auth0.com

# AUTH0_API_AUDIENCE: The API Identifier registered in Auth0. Validated against
#                     the 'aud' claim in incoming JWTs.
AUTH0_API_AUDIENCE=https://your-api-identifier

# AUTH0_ALGORITHMS: The signing algorithm(s) for JWT verification. RS256 is
#                   required per the security architecture specification.
AUTH0_ALGORITHMS=RS256

# AUTH0_ISSUER: The expected token issuer. Must match the 'iss' claim in JWTs.
#              Typically 'https://<AUTH0_DOMAIN>/'.
AUTH0_ISSUER=https://your-tenant.auth0.com/

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# MongoDB 8.0.x is the primary data store. The application uses PyMongo with
# connection pooling and the Repository Pattern for all data access.
#
# MONGODB_URI: Full MongoDB connection string including replica set members.
#              For local development with docker-compose, uses a 3-node replica
#              set on ports 27017-27019. For production, use MongoDB Atlas or
#              DocumentDB connection string.
MONGODB_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/flask_app?replicaSet=rs0

# MONGODB_DATABASE: Name of the MongoDB database for application data.
MONGODB_DATABASE=flask_app

# -----------------------------------------------------------------------------
# AWS S3 Configuration
# -----------------------------------------------------------------------------
# Amazon S3 is used for file upload/download operations via boto3. The file
# service handles multipart uploads, presigned URL generation, and deletion.
#
# AWS_S3_BUCKET: The S3 bucket name for storing uploaded files.
AWS_S3_BUCKET=your-bucket-name

# AWS_ACCESS_KEY_ID: AWS IAM access key for S3 operations.
#                    In production, prefer IAM roles (ECS task roles) over
#                    static credentials.
AWS_ACCESS_KEY_ID=your-access-key

# AWS_SECRET_ACCESS_KEY: AWS IAM secret key paired with the access key above.
#                        Never hardcode in source code or container images.
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS_REGION: AWS region where the S3 bucket is located.
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# The AI service uses LangChain to orchestrate multi-provider LLM access with
# a 3-tier fallback strategy: Primary → Secondary → Tertiary → 503 Service
# Unavailable. Each provider has independent exponential backoff retry logic.
#
# --- Primary LLM Provider ---
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_API_KEY=your-openai-api-key
LLM_PRIMARY_MODEL=gpt-4

# --- Secondary LLM Provider (fallback) ---
LLM_SECONDARY_PROVIDER=anthropic
LLM_SECONDARY_API_KEY=your-anthropic-api-key
LLM_SECONDARY_MODEL=claude-3-sonnet

# --- Tertiary LLM Provider (last resort) ---
LLM_TERTIARY_PROVIDER=google
LLM_TERTIARY_API_KEY=your-google-api-key
LLM_TERTIARY_MODEL=gemini-pro

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) settings for supporting all six client
# platform types: React Web, React Native, Electron, iOS/Swift, Android/Kotlin,
# and macOS/Objective-C. Origins are configurable per environment — development
# allows localhost; production restricts to explicitly listed domains.
#
# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Structured JSON logging compatible with AWS CloudWatch. Log level controls
# verbosity across the application.
#
# LOG_LEVEL: Python logging level. Use 'DEBUG' for development, 'INFO' or
#            'WARNING' for production. Valid values: DEBUG, INFO, WARNING,
#            ERROR, CRITICAL.
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Gunicorn Configuration (Production)
# -----------------------------------------------------------------------------
# These variables can override gunicorn.conf.py settings at runtime.
# Uncomment and set as needed for production deployments.
#
# GUNICORN_WORKERS: Number of Gunicorn worker processes (default: 2 * CPU + 1).
# GUNICORN_WORKERS=5
#
# GUNICORN_BIND: Address and port for Gunicorn to bind to.
# GUNICORN_BIND=0.0.0.0:8000
#
# GUNICORN_TIMEOUT: Worker timeout in seconds. Must accommodate AI-inclusive
#                   requests (up to 15s per the performance targets).
# GUNICORN_TIMEOUT=120

# -----------------------------------------------------------------------------
# AWS Secrets Manager (Production Only)
# -----------------------------------------------------------------------------
# In production, sensitive credentials (AUTH0 secrets, MongoDB connection
# strings, LLM API keys) are retrieved from AWS Secrets Manager instead of
# environment variables. Uncomment and configure for production deployments.
#
# AWS_SECRETS_MANAGER_SECRET_NAME=flask-backend/production
